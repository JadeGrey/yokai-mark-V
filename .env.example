# Discord Configuration (Required)
DISCORD_TOKEN=your_discord_bot_token_here
GUILD_ID=your_single_server_guild_id
OWNER_ID=your_discord_user_id

# Logging & Storage
LOG_LEVEL=INFO
DB_PATH=data/yokai.db

# Spotify Integration (Optional for official API; scraper fallback active by default)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_SCRAPER_ENABLED=true

# YouTube / yt-dlp Configuration
YTDLP_COOKIES_FILE=
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# DENO_PATH=C:\path\to\deno.exe

# Music Queue & Voice Channel Limits
MAX_QUEUE_SIZE=200
MAX_PLAYLIST_TRACKS=100
MAX_TRACK_SECONDS=3600
IDLE_DISCONNECT_SECONDS=300
ALONE_DISCONNECT_SECONDS=120
RECOMMEND_COUNT=8

# Audio pre-buffer: upcoming tracks are downloaded here so track changes are gapless.
# AUDIO_BUFFER_MB=0 disables it. The audio files in it are deleted on startup and on /stop.
AUDIO_BUFFER_MB=500
AUDIO_BUFFER_DIR=data/cache

# Economy: Renown wallet, earning, and rate limits
ECONOMY_DAILY_BASE=100
ECONOMY_WELCOME_BONUS=200
ECONOMY_VOICE_INTERVAL_SECONDS=300
ECONOMY_VOICE_REWARD=5
ECONOMY_COMMAND_REWARD=5
ECONOMY_COMMAND_RATE_LIMIT=5

# Gambling: stake limits (whole Renown)
GAMBLING_MIN_BET=10
GAMBLING_MAX_BET=5000

# Multiplayer tables
# Percent of a duel pot kept by the house (0 disables); it feeds the lottery pot
GAMBLING_DUEL_RAKE_PERCENT=2
# Seconds a table stays open for players to join
GAMBLING_LOBBY_JOIN_SECONDS=60
# Seconds a player has to act on their turn (duel: to pick a number)
GAMBLING_TURN_SECONDS=45
# Percent of a jackpot pot kept by the house (0 disables); it feeds the lottery pot
GAMBLING_JACKPOT_RAKE_PERCENT=2
# Highest multiplier a crash round can reach
GAMBLING_CRASH_MAX_MULTIPLIER=100

# Admin panel (python -m yokai_admin): a local web UI, always bound to 127.0.0.1
ADMIN_PORT=8765
# Folder the bot writes its rotating logs to; the panel reads them from here
LOG_DIR=logs
# Where the panel keeps database backups (default: a backups folder beside DB_PATH)
# BACKUP_DIR=data/backups
