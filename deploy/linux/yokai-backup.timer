# Runs yokai-backup.service every night. Persistent=true catches up after the Pi was off.
# Install: copy next to the .service file, then `sudo systemctl enable --now yokai-backup.timer`.

[Unit]
Description=Nightly Yokai database backup

[Timer]
OnCalendar=*-*-* 04:15:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
